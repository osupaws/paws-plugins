<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PawsPluginName>DbTestPlugin</PawsPluginName>
    <PawsPluginPackageDir>$(ProjectDir)..\dist\$(PawsPluginName)\</PawsPluginPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Paws.Core.Abstractions">
      <HintPath>..\..\Libs\Paws.Core.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="OsuParsers" Version="1.7.2" PrivateAssets="all" />
    <PackageReference Include="Realm" Version="20.1.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackagePawsPlugin" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
    <Message Text="--- Packaging Paws Plugin (DbTest) for Release ---" Importance="high" />

    <RemoveDir Directories="$(PawsPluginPackageDir)" />
    <MakeDir Directories="$(PawsPluginPackageDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PawsPluginPackageDir)" />
    <Copy SourceFiles="$(ProjectDir)plugin.json" DestinationFolder="$(PawsPluginPackageDir)" />
    <!-- DbTest doesn't have icon yet, but we can try copying one if exists -->
    <Copy SourceFiles="$(ProjectDir)..\icon.svg" DestinationFolder="$(PawsPluginPackageDir)" Condition="Exists('$(ProjectDir)..\icon.svg')" />

    <!-- Copy raw UI files for Vanilla JS plugin -->
    <ItemGroup>
      <UiFiles Include="$(ProjectDir)..\ui\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(UiFiles)" DestinationFolder="$(PawsPluginPackageDir)ui\%(RecursiveDir)" />
    <Message Text="Copied UI files to package directory." Importance="normal" />

    <ZipDirectory
        SourceDirectory="$(PawsPluginPackageDir)"
        DestinationFile="$(ProjectDir)..\dist\$(PawsPluginName).pawsplugin"
        Overwrite="true" />

    <Message Text="SUCCESS: Plugin created at $(ProjectDir)..\dist\$(PawsPluginName).pawsplugin" Importance="high" />
  </Target>

</Project>
